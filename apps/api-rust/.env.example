# === Database ===
DATABASE_URL=postgres://talent_os:talent_os_dev_password@localhost:5432/talent_os_dev
DATABASE_POOL_SIZE=20

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Search ===
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=talent_os_dev_typesense_key

# === Storage ===
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=talent-os-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# === Authentication ===
# Generate a production secret with: `openssl rand -hex 32`
# Boot will refuse known-dev defaults when APP_ENV=production.
JWT_SECRET=dev_jwt_secret_change_in_production_minimum_32_chars

# === Server ===
APP_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:3000

# === Logging ===
RUST_LOG=talent_os_api=debug,tower_http=debug

# === Payments (optional) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
