{
  "name": "talent-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run check",
    "api:dev": "cd apps/api-rust && cargo run",
    "web:dev": "cd apps/web && pnpm dev",
    "db:migrate": "cd apps/api-rust && cargo run -- migrate",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.8",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@9.15.0"
}
